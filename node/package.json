{
  "name": "castle-token",
  "version": "0.1.0",
  "description": "Generate the X-Castle-Request-Token header minted by Castle's web SDK — a native Node addon over the Rust core.",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0x640480/castle-rs.git",
    "directory": "node"
  },
  "engines": {
    "node": ">= 10"
  },
  "napi": {
    "binaryName": "castle-token",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ]
}
